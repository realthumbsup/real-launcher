<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:background="?android:attr/selectableItemBackground">
    <ImageView android:id="@+id/drawerIcon" android:layout_width="32dp" android:layout_height="32dp" android:scaleType="fitCenter" />
    <TextView android:id="@+id/drawerLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:textColor="#F9FAFB" android:textSize="16sp" />
</LinearLayout>
